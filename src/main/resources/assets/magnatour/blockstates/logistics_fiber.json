{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "magnatour:block/logistics_fiber" } },
    { "when": { "facing": "east" }, "apply": { "model": "magnatour:block/logistics_fiber", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "magnatour:block/logistics_fiber", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "magnatour:block/logistics_fiber", "y": 270 } },
    { "when": { "facing": "up" }, "apply": { "model": "magnatour:block/logistics_fiber", "x": 270 } },
    { "when": { "facing": "down" }, "apply": { "model": "magnatour:block/logistics_fiber", "x": 90 } },

    { "when": { "north": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_north" } },
    { "when": { "east": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_east" } },
    { "when": { "south": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_south" } },
    { "when": { "west": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_west" } },
    { "when": { "up": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_up" } },
    { "when": { "down": "true" }, "apply": { "model": "magnatour:block/logistics_fiber_arm_down" } }
  ]
}
